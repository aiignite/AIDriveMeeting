DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ai_drive_meeting
DATABASE_URL_SYNC=postgresql://postgres:postgres@127.0.0.1:5432/ai_drive_meeting
SECRET_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456
CORS_ORIGINS=http://localhost:3330
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
AI_PROVIDER=ollama
# Optional cloud providers (configure in /settings/ai/models)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
DEBUG=false
API_DOCS_ENABLED=true
# SSO (AIDriveAll portal) — set SSO_SECRET_KEY to portal SECRET_KEY
SSO_ENABLED=false
SSO_SECRET_KEY=
SSO_ISSUER=aidriveall

# ── 会议语音转写（faster-whisper / 远程 asr_gateway）──
MEETING_WHISPER_MODEL=medium
MEETING_WHISPER_LANGUAGE=zh
MEETING_WHISPER_MAX_CONCURRENT=1
MEETING_ASR_MODE=local
# 远程 ASR 网关示例: http://172.16.17.66:8090/api/v1/transcribe
MEETING_ASR_REMOTE_URL=
MEETING_ASR_REMOTE_API_KEY=
MEETING_ASR_REMOTE_TIMEOUT=3600
MEETING_ASR_FALLBACK_LOCAL=false
MEETING_WHISPER_DEVICE=cpu
MEETING_WHISPER_COMPUTE_TYPE=int8
MEETING_SPLIT_SILENCE_DB=-40
MEETING_SPLIT_SILENCE_DURATION=0.5
MEETING_SPLIT_MAX_SEGMENT_SECONDS=60
MEETING_SPLIT_MIN_SEGMENT_SECONDS=3.0
MEETING_MAX_RECORDING_BYTES=524288000
MEETING_ENABLE_SPEAKER_DIARIZATION=false
MEETING_MERGE_MIN_PARAGRAPH_CHARS=80
MEETING_MERGE_MAX_PARAGRAPH_CHARS=400
MEETING_MERGE_SOFT_PAUSE_SECONDS=3.0
MEETING_MERGE_HARD_PAUSE_SECONDS=4.0
MEETING_AI_PROVIDER=
MEETING_AI_MODEL=
